<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher_static"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_static_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenVoiceIME">

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_static"
            android:roundIcon="@mipmap/ic_launcher_static_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.ServerSettingsActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.DictationSettingsActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.BehaviorSettingsActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.MessageSettingsActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.MetricsActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.SetupGuideActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".sharing.SharedTranscriptionActivity"
            android:exported="true"
            android:label="@string/share_target"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.OpenVoiceIME.Transcript">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>

        <service
            android:name=".sharing.MessageTranscriptionService"
            android:exported="true"
            android:label="@string/message_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/message_transcription" />
        </service>

        <service
            android:name=".DictationShortcutService"
            android:exported="true"
            android:label="@string/shortcut_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/dictation_shortcut" />
        </service>

        <service
            android:name=".RemoteSttInputMethodService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_static"
            android:roundIcon="@mipmap/ic_launcher_static_round"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>

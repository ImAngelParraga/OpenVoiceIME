<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/settings_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/setup_guide_intro"
                android:textAppearance="@style/TextAppearance.OpenVoiceIME.Body" />

            <TextView
                style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/setup_route_title" />

            <LinearLayout style="@style/Widget.OpenVoiceIME.Settings.Card">

                <RadioGroup
                    android:id="@+id/setupRouteGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/setupUseHeliboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/setup_use_heliboard"
                        android:textAppearance="@style/TextAppearance.OpenVoiceIME.RowTitle" />

                    <RadioButton
                        android:id="@+id/setupKeepKeyboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/setup_keep_keyboard"
                        android:textAppearance="@style/TextAppearance.OpenVoiceIME.RowTitle" />
                </RadioGroup>

                <TextView
                    android:id="@+id/setupGboardWarning"
                    style="@style/Widget.OpenVoiceIME.Settings.Help"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_gboard_warning" />

                <LinearLayout
                    android:id="@+id/setupHeliboardPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/setup_heliboard_instructions"
                        android:textAppearance="@style/TextAppearance.OpenVoiceIME.Body" />

                    <TextView
                        android:id="@+id/setupHeliboardStatus"
                        style="@style/Widget.OpenVoiceIME.Settings.Help"
                        android:layout_marginTop="8dp"
                        android:text="@string/setup_heliboard_missing" />

                    <Button
                        android:id="@+id/setupDownloadHeliboard"
                        style="@style/Widget.OpenVoiceIME.Settings.SecondaryButton"
                        android:layout_marginTop="12dp"
                        android:text="@string/setup_download_heliboard" />

                    <Button
                        android:id="@+id/setupOpenHeliboard"
                        style="@style/Widget.OpenVoiceIME.Settings.SecondaryButton"
                        android:layout_marginTop="8dp"
                        android:text="@string/setup_open_heliboard" />
                </LinearLayout>

                <TextView
                    android:id="@+id/setupCurrentKeyboardPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setup_current_instructions"
                    android:textAppearance="@style/TextAppearance.OpenVoiceIME.Body"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/settings_microphone_step" />

            <LinearLayout style="@style/Widget.OpenVoiceIME.Settings.Card">

                <include
                    android:id="@+id/microphoneStatusRow"
                    layout="@layout/settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:layout_marginEnd="-12dp" />

                <TextView
                    style="@style/Widget.OpenVoiceIME.Settings.Help"
                    android:text="@string/settings_microphone_description" />

                <Button
                    android:id="@+id/permissionButton"
                    style="@style/Widget.OpenVoiceIME.Settings.PrimaryButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/button_grant_microphone" />
            </LinearLayout>

            <TextView
                style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/settings_keyboard_step" />

            <LinearLayout style="@style/Widget.OpenVoiceIME.Settings.Card">

                <include
                    android:id="@+id/keyboardStatusRow"
                    layout="@layout/settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:layout_marginEnd="-12dp" />

                <TextView
                    style="@style/Widget.OpenVoiceIME.Settings.Help"
                    android:text="@string/settings_keyboard_description" />

                <Button
                    android:id="@+id/enableImeButton"
                    style="@style/Widget.OpenVoiceIME.Settings.SecondaryButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/button_open_keyboard_settings" />
            </LinearLayout>

            <TextView
                style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/setup_test_title" />

            <LinearLayout style="@style/Widget.OpenVoiceIME.Settings.Card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_test_help"
                    android:textAppearance="@style/TextAppearance.OpenVoiceIME.Body" />

                <EditText
                    android:id="@+id/setupTestInput"
                    style="@style/Widget.OpenVoiceIME.Settings.Field"
                    android:layout_marginTop="12dp"
                    android:hint="@string/setup_test_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="56dp" />

                <Button
                    android:id="@+id/setupChooseKeyboard"
                    style="@style/Widget.OpenVoiceIME.Settings.SecondaryButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_choose_keyboard" />

                <TextView
                    style="@style/Widget.OpenVoiceIME.Settings.Help"
                    android:layout_marginTop="12dp"
                    android:text="@string/setup_server_help" />

                <Button
                    android:id="@+id/setupConfigureServer"
                    style="@style/Widget.OpenVoiceIME.Settings.TextButton"
                    android:text="@string/setup_configure_server" />
            </LinearLayout>

            <TextView
                style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/shortcut_title" />

            <LinearLayout style="@style/Widget.OpenVoiceIME.Settings.Card">

                <TextView
                    android:id="@+id/setupShortcutStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.OpenVoiceIME.RowTitle" />

                <TextView
                    style="@style/Widget.OpenVoiceIME.Settings.Help"
                    android:layout_marginTop="8dp"
                    android:text="@string/shortcut_instructions" />

                <Button
                    android:id="@+id/setupShortcutButton"
                    style="@style/Widget.OpenVoiceIME.Settings.SecondaryButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/shortcut_setup" />

                <TextView
                    style="@style/Widget.OpenVoiceIME.Settings.Help"
                    android:layout_marginTop="12dp"
                    android:text="@string/shortcut_diagnostics_help" />

                <Button
                    android:id="@+id/setupCopyShortcutDiagnostics"
                    style="@style/Widget.OpenVoiceIME.Settings.TextButton"
                    android:text="@string/shortcut_diagnostics_title" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

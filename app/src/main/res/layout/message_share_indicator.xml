<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="48dp"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:background="@drawable/share_pill_background" android:elevation="6dp"
    android:paddingStart="16dp">
    <ProgressBar android:layout_width="18dp" android:layout_height="18dp"
        android:indeterminateTint="@color/ime_on_accent" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:text="@string/share_snapshot_preparing"
        android:singleLine="true" android:ellipsize="end" android:maxWidth="180dp" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ime_on_accent" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/shareCoverCancel"
        style="@style/Widget.OpenVoiceIME.Action" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_marginStart="4dp" android:background="@android:color/transparent"
        android:text="@string/share_close_icon" android:textSize="24sp" android:textColor="@color/ime_on_accent"
        android:contentDescription="@string/share_cancel" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/settings_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="@string/server_connection" />

            <LinearLayout style="@style/Widget.OpenVoiceIME.Settings.Card">

                <include
                    android:id="@+id/presetRow"
                    layout="@layout/settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:layout_marginEnd="-12dp" />

                <TextView
                    style="@style/Widget.OpenVoiceIME.Settings.Label"
                    android:labelFor="@id/baseUrlInput"
                    android:text="@string/settings_server_url" />

                <EditText
                    android:id="@+id/baseUrlInput"
                    style="@style/Widget.OpenVoiceIME.Settings.Field"
                    android:hint="@string/hint_server_url"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/baseUrlError"
                    style="@style/Widget.OpenVoiceIME.Settings.Help"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/validation_server_url"
                    android:textColor="@color/ime_danger"
                    android:visibility="gone" />

                <TextView
                    style="@style/Widget.OpenVoiceIME.Settings.Label"
                    android:labelFor="@id/tokenInput"
                    android:text="@string/settings_api_token" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/tokenInput"
                        style="@style/Widget.OpenVoiceIME.Settings.Field"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:inputType="textPassword"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/tokenVisibilityButton"
                        style="@style/Widget.OpenVoiceIME.Settings.TextButton"
                        android:layout_marginStart="4dp"
                        android:text="@string/button_show" />
                </LinearLayout>

                <include
                    android:id="@+id/modelRow"
                    layout="@layout/settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="-12dp" />

                <EditText
                    android:id="@+id/customModelInput"
                    style="@style/Widget.OpenVoiceIME.Settings.Field"
                    android:layout_marginTop="4dp"
                    android:hint="@string/hint_custom_model"
                    android:inputType="text"
                    android:singleLine="true"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/modelCatalogStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/model_catalog_needs_connection"
                        android:textAppearance="@style/TextAppearance.OpenVoiceIME.RowSummary" />

                    <Button
                        android:id="@+id/refreshModelsButton"
                        style="@style/Widget.OpenVoiceIME.Settings.TextButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/button_refresh_models" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/server_test_title" />

            <LinearLayout style="@style/Widget.OpenVoiceIME.Settings.Card">

                <include
                    android:id="@+id/connectionStatusRow"
                    layout="@layout/settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:layout_marginEnd="-12dp" />

                <TextView
                    android:id="@+id/diagnosticOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/share_text_background"
                    android:padding="12dp"
                    android:textAppearance="@style/TextAppearance.OpenVoiceIME.Body"
                    android:textIsSelectable="true"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/testServerButton"
                    style="@style/Widget.OpenVoiceIME.Settings.PrimaryButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/button_test_server" />
            </LinearLayout>

            <Button
                android:id="@+id/savePresetButton"
                style="@style/Widget.OpenVoiceIME.Settings.TextButton"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/button_save_preset" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

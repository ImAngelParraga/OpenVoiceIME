<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_background">

    <!-- The IME replaces root layout parameters; keep the height on a child. -->
    <dev.rankis.openime.CenteredImePanel
        android:id="@+id/imePanel"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/ime_background"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/imeHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/button_open_settings"
                android:padding="14dp"
                app:srcCompat="@drawable/ime_settings"
                app:tint="@color/ime_muted" />

            <TextView
                android:id="@+id/languageButton"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/settings_transcription_language"
                android:gravity="center"
                android:text="@string/language_auto"
                android:textColor="@color/ime_muted"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/keyboardButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/button_return_to_keyboard_description"
                android:padding="13dp"
                app:srcCompat="@drawable/ic_keyboard_return"
                app:tint="@color/ime_muted" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/statusScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/status_recording"
                        android:textColor="@color/ime_text"
                        android:textIsSelectable="true"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/timerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:text="00:00"
                        android:textColor="@color/ime_muted"
                        android:textSize="13sp" />
                    <dev.rankis.openime.AudioLevelView
                        android:id="@+id/levelBar"
                        android:layout_width="64dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <EditText
                    android:id="@+id/errorDetailsInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="start|top"
                    android:hint="@string/hint_server_error"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:padding="8dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/ime_text"
                    android:textColorHint="@color/ime_muted"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cancelButton"
                style="@style/Widget.OpenVoiceIME.Action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/button_cancel"
                android:textColor="@color/ime_danger"
                app:drawableStartCompat="@drawable/ime_cancel"
                app:drawableTint="@color/ime_danger" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/pauseButton"
                style="@style/Widget.OpenVoiceIME.Action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/button_pause"
                app:drawableStartCompat="@drawable/ime_pause"
                app:drawableTint="@color/ime_action_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editControlsRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/deleteButton"
                style="@style/Widget.OpenVoiceIME.Action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/button_delete_description"
                android:text="@string/button_delete"
                app:drawableStartCompat="@drawable/ime_delete"
                app:drawableTint="@color/ime_action_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/stopButton"
                style="@style/Widget.OpenVoiceIME.Action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/ime_primary_background"
                android:text="@string/button_stop"
                android:textColor="@color/ime_on_accent"
                app:drawableStartCompat="@drawable/ime_transcribe"
                app:drawableTint="@color/ime_on_accent" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/retryButton"
            style="@style/Widget.OpenVoiceIME.Action"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="@string/button_retry"
            android:visibility="gone" />
    </dev.rankis.openime.CenteredImePanel>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/settings_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/metricsEmpty"
                style="@style/Widget.OpenVoiceIME.Settings.Card"
                android:layout_marginTop="8dp"
                android:text="@string/metrics_empty"
                android:textAppearance="@style/TextAppearance.OpenVoiceIME.Body"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/metricsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/metricsTiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                    android:accessibilityHeading="true"
                    android:text="@string/metrics_by_size" />

                <LinearLayout
                    android:id="@+id/metricsBuckets"
                    style="@style/Widget.OpenVoiceIME.Settings.Card"
                    android:divider="@drawable/settings_divider"
                    android:padding="4dp"
                    android:showDividers="middle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/copyMetricsButton"
                        style="@style/Widget.OpenVoiceIME.Settings.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/button_copy" />

                    <Button
                        android:id="@+id/shareMetricsButton"
                        style="@style/Widget.OpenVoiceIME.Settings.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/button_share" />
                </LinearLayout>

                <Button
                    android:id="@+id/resetMetricsButton"
                    style="@style/Widget.OpenVoiceIME.Settings.TextButton"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/button_reset_metrics"
                    android:textColor="@color/ime_danger" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

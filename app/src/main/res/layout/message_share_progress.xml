<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shareCover" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp"
    android:background="@color/ime_background" android:clickable="true" android:focusable="false">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="14sp" android:textColor="@color/ime_muted" />
    <ProgressBar android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginTop="24dp" android:indeterminateTint="@color/ime_accent" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:gravity="center" android:text="@string/share_cover_title"
        android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ime_text" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center" android:text="@string/share_cover_detail"
        android:textSize="16sp" android:textColor="@color/ime_muted" />
    <Button android:id="@+id/shareCoverCancel" style="@style/Widget.OpenVoiceIME.Action"
        android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="32dp"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:text="@string/share_cancel" />
</LinearLayout>

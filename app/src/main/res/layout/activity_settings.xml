<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.OpenVoiceIME.ScreenTitle"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="@string/version_placeholder"
            android:textAppearance="@style/TextAppearance.OpenVoiceIME.RowSummary" />

        <LinearLayout
            style="@style/Widget.OpenVoiceIME.Settings.Card"
            android:layout_marginTop="20dp"
            android:padding="4dp">

            <TextView
                android:id="@+id/readinessTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.OpenVoiceIME.RowTitle"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/readinessSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/TextAppearance.OpenVoiceIME.RowSummary" />

            <LinearLayout
                android:id="@+id/readinessRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
            android:accessibilityHeading="true"
            android:text="@string/settings_group_transcription" />

        <LinearLayout
            android:id="@+id/transcriptionRows"
            style="@style/Widget.OpenVoiceIME.Settings.Card"
            android:divider="@drawable/settings_divider"
            android:padding="4dp"
            android:showDividers="middle" />

        <TextView
            style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
            android:accessibilityHeading="true"
            android:text="@string/settings_group_more" />

        <LinearLayout
            android:id="@+id/moreRows"
            style="@style/Widget.OpenVoiceIME.Settings.Card"
            android:divider="@drawable/settings_divider"
            android:padding="4dp"
            android:showDividers="middle" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/settings_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="@string/behavior_after_insert" />

            <RadioGroup
                android:id="@+id/afterInsertGroup"
                style="@style/Widget.OpenVoiceIME.Settings.Card"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/behavior_insertion" />

            <LinearLayout
                android:id="@+id/insertionRows"
                style="@style/Widget.OpenVoiceIME.Settings.Card"
                android:divider="@drawable/settings_divider"
                android:padding="4dp"
                android:showDividers="middle" />

            <TextView
                style="@style/Widget.OpenVoiceIME.Settings.SectionHeader"
                android:accessibilityHeading="true"
                android:text="@string/behavior_cancel" />

            <LinearLayout
                android:id="@+id/cancelRows"
                style="@style/Widget.OpenVoiceIME.Settings.Card"
                android:padding="4dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

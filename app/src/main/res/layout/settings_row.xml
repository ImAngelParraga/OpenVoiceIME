<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.OpenVoiceIME.Settings.Row">

    <TextView
        android:id="@+id/rowBadge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/settings_status_badge"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.OpenVoiceIME.RowTitle" />

        <TextView
            android:id="@+id/rowSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.OpenVoiceIME.RowSummary"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/rowAction"
        style="@style/Widget.OpenVoiceIME.Settings.TextButton"
        android:layout_width="48dp"
        android:layout_marginStart="8dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:textColor="@color/ime_muted"
        android:textSize="20sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone" />
</LinearLayout>

    <string name="shortcut_service_name">OpenVoiceIME keyboard shortcut</string>
    <string name="shortcut_service_description">Ctrl+Shift+Space opens dictation. Ctrl+Shift+Enter transcribes, inserts, and hides the panel without switching keyboards. Filters these shortcuts; does not read screen content or save typed text. Enable OpenVoiceIME as a keyboard first. Requires Android 11 or newer.</string>
    <string name="shortcut_title">Physical keyboard shortcut</string>
    <string name="shortcut_instructions">Enable OpenVoiceIME keyboard shortcut in Android Accessibility settings. Keep your virtual keyboard hidden and focus a text field. Ctrl+Shift+Space opens recording; Ctrl+Shift+Enter transcribes, inserts, and hides the panel without switching keyboards or sending Enter to the app. Errors keep the panel open; press the finish shortcut again to retry. Confirmation is skipped for this action only. The optional service does not read screen content or save typed text.</string>
    <string name="shortcut_setup">Set up keyboard shortcut</string>
    <string name="shortcut_enabled">Shortcut service enabled: Ctrl+Shift+Space to record; Ctrl+Shift+Enter to insert and hide.</string>
    <string name="shortcut_disabled">Shortcut service disabled. Enable it in Android Accessibility settings.</string>
    <string name="shortcut_unsupported">The global shortcut requires Android 11 or newer.</string>
    <string name="shortcut_enable_ime">Enable OpenVoiceIME in Android keyboard settings first.</string>
    <string name="shortcut_open_failed">Could not open dictation. Focus a text field and try Ctrl+Shift+Space again.</string>
    <string name="shortcut_diagnostics_title">Copy shortcut diagnostics</string>
    <string name="shortcut_diagnostics_help">If the panel does not appear or closes, try the shortcut and return here to copy diagnostics. Keeps up to 80 local shortcut/panel events; excludes typed text, audio, tokens and server addresses. Copied only when you tap this button.</string>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <activity android:name=".ShareFixtureActivity" android:exported="false" />
        <provider android:name=".ShareFixtureProvider" android:authorities="${applicationId}.share-fixture"
            android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".MessageTestAccessibilityService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/message_transcription" />
        </service>
        <activity android:name=".IntegrationHostActivity" android:exported="false" />
        <service
            android:name=".ShortcutTestAccessibilityService"
            android:exported="true"
            android:label="@string/shortcut_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/dictation_shortcut" />
        </service>
        <service
            android:name=".SystemImeTestService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
